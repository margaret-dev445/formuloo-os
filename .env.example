── Variables d'environnement Formuloo OS ──

Base de données RH

POSTGRES_HR_HOST=postgres-hr
POSTGRES_HR_PORT=5432
POSTGRES_HR_DB=hr_db
POSTGRES_HR_USER=user
POSTGRES_HR_PASSWORD=your-password-here

Base de données CRM

POSTGRES_CRM_HOST=postgres-crm
POSTGRES_CRM_PORT=5433
POSTGRES_CRM_DB=crm_db
POSTGRES_CRM_USER=user
POSTGRES_CRM_PASSWORD=your-password-here

Base de données Stock

POSTGRES_STOCK_HOST=postgres-stock
POSTGRES_STOCK_PORT=5435
POSTGRES_STOCK_DB=stock_db
POSTGRES_STOCK_USER=user
POSTGRES_STOCK_PASSWORD=your-password-here

Base de données Comptabilité

POSTGRES_COMPTA_HOST=postgres-compta
POSTGRES_COMPTA_PORT=5433
POSTGRES_COMPTA_DB=compta_db
POSTGRES_COMPTA_USER=user
POSTGRES_COMPTA_PASSWORD=your-password-here

Base de données Projet

POSTGRES_PROJET_HOST=postgres-projet
POSTGRES_PROJET_PORT=5436
POSTGRES_PROJET_DB=projet_db
POSTGRES_PROJET_USER=user
POSTGRES_PROJET_PASSWORD=your-password-here

MongoDB Reporting

MONGODB_HOST=mongodb-reporting
MONGODB_PORT=27017
MONGODB_DB=reporting_db

JWT

JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

Kong

KONG_ADMIN_URL=http://kong:8001

Monitoring

PROMETHEUS_PORT=9090
GRAFANA_PORT=3100
GRAFANA_ADMIN_PASSWORD=your-grafana-password-here

Environment

NODE_ENV=development